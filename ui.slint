import {
    Button,
    CheckBox,
    ComboBox,
    GroupBox,
    HorizontalBox,
    LineEdit,
    Slider,
    TabWidget,
    VerticalBox
} from "std-widgets.slint";

component SettingRow inherits HorizontalBox {
    in property <string> label;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step: 1;
    in property <string> value-text;
    in property <bool> controls-enabled: true;
    in-out property <float> value;

    callback changed(float);

    spacing: 10px;
    vertical-stretch: 0;

    Text {
        text: root.label;
        width: 132px;
        vertical-alignment: center;
    }

    Slider {
        value <=> root.value;
        minimum: root.minimum;
        maximum: root.maximum;
        step: root.step;
        enabled: root.controls-enabled;
        horizontal-stretch: 1;

        changed(value) => {
            root.changed(value);
        }
    }

    Text {
        text: root.value-text;
        width: 48px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

export component AppWindow inherits Window {
    title: "Dynamic Color Profiles";
    icon: @image-url("assets/tray-icon.svg");
    preferred-width: 480px;
    preferred-height: 360px;
    min-width: 420px;
    min-height: 600px;

    in property <[string]> profiles;
    in property <string> default-profile-name: "Default";
    in-out property <int> selected-profile: -1;
    in-out property <string> profile-name;
    in-out property <float> brightness: 50;
    in-out property <float> contrast: 50;
    in-out property <float> gamma: 1;
    in-out property <float> vibrance: 50;
    in-out property <float> hue: 0;

    in-out property <string> brightness-text: "50";
    in-out property <string> contrast-text: "50";
    in-out property <string> gamma-text: "1.00";
    in-out property <string> vibrance-text: "50";
    in-out property <string> hue-text: "0";
    in-out property <bool> open-on-startup: false;
    in-out property <bool> close-keep-running-in-tray: true;
    in-out property <bool> close-quit: false;
    in-out property <bool> apply-exit-profile: false;
    in-out property <int> exit-profile-index: 0;

    callback save-profile(string);
    callback reset-settings();
    callback profile-selected(string);
    callback brightness-changed(float);
    callback contrast-changed(float);
    callback gamma-changed(float);
    callback vibrance-changed(float);
    callback hue-changed(float);
    callback open-on-startup-changed(bool);
    callback close-action-changed(int);
    callback apply-exit-profile-changed(bool);
    callback exit-profile-selected(string);

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        Text {
            text: "Dynamic Color Profiles";
            font-size: 18px;
            vertical-stretch: 0;
        }

        TabWidget {
            vertical-stretch: 1;
            horizontal-stretch: 1;

            Tab {
                title: "Profiles";

                VerticalBox {
                    spacing: 12px;

                    GroupBox {
                        title: "Profile";
                        vertical-stretch: 0;

                        VerticalBox {
                            spacing: 8px;

                            HorizontalBox {
                                spacing: 8px;

                                LineEdit {
                                    text <=> root.profile-name;
                                    placeholder-text: "Profile name";
                                    horizontal-stretch: 1;

                                    accepted(text) => {
                                        root.save-profile(text);
                                    }
                                }

                                Button {
                                    text: "Save";
                                    enabled: root.profile-name != ""
                                        && root.profile-name != root.default-profile-name;

                                    clicked => {
                                        root.save-profile(root.profile-name);
                                    }
                                }
                            }

                            ComboBox {
                                model: root.profiles;
                                current-index <=> root.selected-profile;
                                enabled: root.profiles.length > 0;
                                horizontal-stretch: 1;

                                selected => {
                                    root.profile-name = self.current-value;
                                    root.profile-selected(self.current-value);
                                }
                            }
                        }
                    }

                    GroupBox {
                        title: "Adjustments";
                        vertical-stretch: 1;

                        VerticalBox {
                            spacing: 10px;

                            SettingRow {
                                label: "Brightness";
                                minimum: 0;
                                maximum: 100;
                                value <=> root.brightness;
                                value-text: root.brightness-text;
                                changed(value) => { root.brightness-changed(value); }
                            }

                            SettingRow {
                                label: "Contrast";
                                minimum: 0;
                                maximum: 100;
                                value <=> root.contrast;
                                value-text: root.contrast-text;
                                changed(value) => { root.contrast-changed(value); }
                            }

                            SettingRow {
                                label: "Gamma";
                                minimum: 0.4;
                                maximum: 2.8;
                                step: 0.01;
                                value <=> root.gamma;
                                value-text: root.gamma-text;
                                changed(value) => { root.gamma-changed(value); }
                            }

                            SettingRow {
                                label: "Digital Vibrance";
                                minimum: 0;
                                maximum: 100;
                                value <=> root.vibrance;
                                value-text: root.vibrance-text;
                                changed(value) => { root.vibrance-changed(value); }
                            }

                            SettingRow {
                                label: "Hue";
                                minimum: 0;
                                maximum: 359;
                                value <=> root.hue;
                                value-text: root.hue-text;
                                changed(value) => { root.hue-changed(value); }
                            }

                            HorizontalBox {
                                alignment: end;
                                vertical-stretch: 0;

                                Button {
                                    text: "Reset";
                                    clicked => {
                                        root.reset-settings();
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Tab {
                title: "Settings";

                VerticalBox {
                    spacing: 12px;

                    GroupBox {
                        title: "Startup";
                        vertical-stretch: 0;

                        VerticalBox {
                            spacing: 8px;

                            CheckBox {
                                text: "Open the app on startup";
                                checked <=> root.open-on-startup;

                                toggled => {
                                    root.open-on-startup-changed(self.checked);
                                }
                            }
                        }
                    }

                    GroupBox {
                        title: "When closing window";
                        vertical-stretch: 0;

                        VerticalBox {
                            spacing: 8px;

                            CheckBox {
                                text: "Keep running in tray";
                                checked <=> root.close-keep-running-in-tray;

                                toggled => {
                                    root.close-keep-running-in-tray = true;
                                    root.close-quit = false;
                                    root.close-action-changed(0);
                                }
                            }

                            CheckBox {
                                text: "Quit";
                                checked <=> root.close-quit;

                                toggled => {
                                    root.close-quit = true;
                                    root.close-keep-running-in-tray = false;
                                    root.close-action-changed(1);
                                }
                            }
                        }
                    }

                    GroupBox {
                        title: "Exit profile";
                        vertical-stretch: 0;

                        VerticalBox {
                            spacing: 8px;

                            CheckBox {
                                text: "Load selected profile on exit";
                                checked <=> root.apply-exit-profile;

                                toggled => {
                                    root.apply-exit-profile-changed(self.checked);
                                }
                            }

                            ComboBox {
                                model: root.profiles;
                                current-index <=> root.exit-profile-index;
                                enabled: root.apply-exit-profile
                                    && root.profiles.length > 0;
                                horizontal-stretch: 1;

                                selected => {
                                    root.exit-profile-selected(self.current-value);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component AppTray inherits SystemTrayIcon {
    title: "Dynamic Color Profiles";
    tooltip: "Dynamic Color Profiles";
    icon: @image-url("assets/tray-icon.svg");

    in property <[string]> profiles;

    callback show-window();
    callback load-profile(string);
    callback quit-requested();

    clicked => {
        show-window();
    }

    Menu {
        MenuItem {
            title: "Open";
            activated => { root.show-window(); }
        }

        MenuSeparator {}

        if root.profiles.length == 0 : MenuItem {
            title: "No saved profiles";
            enabled: false;
        }

        for profile in root.profiles : MenuItem {
            title: profile;
            activated => { root.load-profile(profile); }
        }

        MenuSeparator {}

        MenuItem {
            title: "Exit";
            activated => { root.quit-requested(); }
        }
    }
}
