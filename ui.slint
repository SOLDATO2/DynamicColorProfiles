import {
    Button,
    CheckBox,
    ComboBox,
    GroupBox,
    HorizontalBox,
    LineEdit,
    Slider,
    TabWidget,
    VerticalBox
} from "std-widgets.slint";

component SettingRow inherits HorizontalBox {
    in property <string> label;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step: 1;
    in property <string> value-text;
    in property <bool> controls-enabled: true;
    in-out property <float> value;

    callback changed(float);

    spacing: 10px;
    vertical-stretch: 0;

    Text {
        text: root.label;
        width: 132px;
        vertical-alignment: center;
    }

    Slider {
        value <=> root.value;
        minimum: root.minimum;
        maximum: root.maximum;
        step: root.step;
        enabled: root.controls-enabled;
        horizontal-stretch: 1;

        changed(value) => {
            root.changed(value);
        }
    }

    Text {
        text: root.value-text;
        width: 48px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

export component AppWindow inherits Window {
    title: "Dynamic Color Profiles";
    icon: @image-url("assets/tray-icon.svg");
    preferred-width: 480px;
    preferred-height: 360px;
    min-width: 420px;
    min-height: 600px;

    in property <[string]> profiles;
    in property <string> default-profile-name: "Default";
    in-out property <int> selected-backend: -1;
    in-out property <int> selected-profile: -1;
    in-out property <string> profile-name;
    in-out property <float> nvidia-brightness: 50;
    in-out property <float> nvidia-contrast: 50;
    in-out property <float> nvidia-gamma: 1;
    in-out property <float> nvidia-vibrance: 50;
    in-out property <float> nvidia-hue: 0;

    in-out property <float> amd-brightness: 0;
    in-out property <float> amd-hue: 0;
    in-out property <float> amd-contrast: 100;
    in-out property <float> amd-saturation: 100;

    in-out property <string> nvidia-brightness-text: "50";
    in-out property <string> nvidia-contrast-text: "50";
    in-out property <string> nvidia-gamma-text: "1.00";
    in-out property <string> nvidia-vibrance-text: "50";
    in-out property <string> nvidia-hue-text: "0";
    in-out property <string> amd-brightness-text: "0";
    in-out property <string> amd-hue-text: "0";
    in-out property <string> amd-contrast-text: "100";
    in-out property <string> amd-saturation-text: "100";
    in-out property <bool> open-on-startup: false;
    in-out property <bool> close-keep-running-in-tray: true;
    in-out property <bool> close-quit: false;
    in-out property <bool> apply-exit-profile: false;
    in-out property <int> exit-profile-index: 0;

    callback save-profile(string);
    callback reset-settings();
    callback profile-selected(string);
    callback nvidia-brightness-changed(float);
    callback nvidia-contrast-changed(float);
    callback nvidia-gamma-changed(float);
    callback nvidia-vibrance-changed(float);
    callback nvidia-hue-changed(float);
    callback open-on-startup-changed(bool);
    callback close-action-changed(int);
    callback apply-exit-profile-changed(bool);
    callback exit-profile-selected(string);
    callback amd-brightness-changed(float);
    callback amd-hue-changed(float);
    callback amd-contrast-changed(float);
    callback amd-saturation-changed(float);

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        HorizontalBox {
            spacing: 10px;
            vertical-stretch: 0;

            Text {
                text: "Dynamic Color Profiles";
                font-size: 18px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Text {
                text: root.selected-backend == 0 ? "NVIDIA"
                    : root.selected-backend == 1 ? "AMD"
                    : "Unavailable";
                vertical-alignment: center;
            }
        }

        TabWidget {
            vertical-stretch: 1;
            horizontal-stretch: 1;

            Tab {
                title: "Profiles";

                VerticalBox {
                    spacing: 12px;

                    GroupBox {
                        title: "Profile";
                        vertical-stretch: 0;

                        VerticalBox {
                            spacing: 8px;

                            HorizontalBox {
                                spacing: 8px;

                                LineEdit {
                                    text <=> root.profile-name;
                                    placeholder-text: "Profile name";
                                    horizontal-stretch: 1;

                                    accepted(text) => {
                                        root.save-profile(text);
                                    }
                                }

                                Button {
                                    text: "Save";
                                    enabled: root.selected-backend >= 0
                                        && root.profile-name != ""
                                        && root.profile-name != root.default-profile-name;

                                    clicked => {
                                        root.save-profile(root.profile-name);
                                    }
                                }
                            }

                            ComboBox {
                                model: root.profiles;
                                current-index <=> root.selected-profile;
                                enabled: root.profiles.length > 0;
                                horizontal-stretch: 1;

                                selected => {
                                    root.profile-name = self.current-value;
                                    root.profile-selected(self.current-value);
                                }
                            }
                        }
                    }

                    GroupBox {
                        title: "Adjustments";
                        vertical-stretch: 1;

                        VerticalBox {
                            spacing: 10px;

                            if root.selected-backend == 0 : VerticalBox {
                                spacing: 10px;

                                SettingRow {
                                    label: "Brightness";
                                    minimum: 0;
                                    maximum: 100;
                                    value <=> root.nvidia-brightness;
                                    value-text: root.nvidia-brightness-text;
                                    changed(value) => { root.nvidia-brightness-changed(value); }
                                }

                                SettingRow {
                                    label: "Contrast";
                                    minimum: 0;
                                    maximum: 100;
                                    value <=> root.nvidia-contrast;
                                    value-text: root.nvidia-contrast-text;
                                    changed(value) => { root.nvidia-contrast-changed(value); }
                                }

                                SettingRow {
                                    label: "Gamma";
                                    minimum: 0.4;
                                    maximum: 2.8;
                                    step: 0.01;
                                    value <=> root.nvidia-gamma;
                                    value-text: root.nvidia-gamma-text;
                                    changed(value) => { root.nvidia-gamma-changed(value); }
                                }

                                SettingRow {
                                    label: "Digital Vibrance";
                                    minimum: 0;
                                    maximum: 100;
                                    value <=> root.nvidia-vibrance;
                                    value-text: root.nvidia-vibrance-text;
                                    changed(value) => { root.nvidia-vibrance-changed(value); }
                                }

                                SettingRow {
                                    label: "Hue";
                                    minimum: 0;
                                    maximum: 359;
                                    value <=> root.nvidia-hue;
                                    value-text: root.nvidia-hue-text;
                                    changed(value) => { root.nvidia-hue-changed(value); }
                                }
                            }

                            if root.selected-backend == 1 : VerticalBox {
                                spacing: 10px;

                                SettingRow {
                                    label: "Brightness";
                                    minimum: -100;
                                    maximum: 100;
                                    value <=> root.amd-brightness;
                                    value-text: root.amd-brightness-text;
                                    changed(value) => { root.amd-brightness-changed(value); }
                                }

                                SettingRow {
                                    label: "Hue";
                                    minimum: -30;
                                    maximum: 30;
                                    value <=> root.amd-hue;
                                    value-text: root.amd-hue-text;
                                    changed(value) => { root.amd-hue-changed(value); }
                                }

                                SettingRow {
                                    label: "Contrast";
                                    minimum: 0;
                                    maximum: 200;
                                    value <=> root.amd-contrast;
                                    value-text: root.amd-contrast-text;
                                    changed(value) => { root.amd-contrast-changed(value); }
                                }

                                SettingRow {
                                    label: "Saturation";
                                    minimum: 0;
                                    maximum: 200;
                                    value <=> root.amd-saturation;
                                    value-text: root.amd-saturation-text;
                                    changed(value) => { root.amd-saturation-changed(value); }
                                }
                            }

                            if root.selected-backend < 0 : Text {
                                text: "No supported graphics backend is available.";
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            HorizontalBox {
                                alignment: end;
                                vertical-stretch: 0;

                                Button {
                                    text: "Reset";
                                    clicked => {
                                        root.reset-settings();
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Tab {
                title: "Settings";

                VerticalBox {
                    spacing: 12px;

                    GroupBox {
                        title: "Startup";
                        vertical-stretch: 0;

                        VerticalBox {
                            spacing: 8px;

                            CheckBox {
                                text: "Open the app on startup";
                                checked <=> root.open-on-startup;

                                toggled => {
                                    root.open-on-startup-changed(self.checked);
                                }
                            }
                        }
                    }

                    GroupBox {
                        title: "When closing window";
                        vertical-stretch: 0;

                        VerticalBox {
                            spacing: 8px;

                            CheckBox {
                                text: "Keep running in tray";
                                checked <=> root.close-keep-running-in-tray;

                                toggled => {
                                    root.close-keep-running-in-tray = true;
                                    root.close-quit = false;
                                    root.close-action-changed(0);
                                }
                            }

                            CheckBox {
                                text: "Quit";
                                checked <=> root.close-quit;

                                toggled => {
                                    root.close-quit = true;
                                    root.close-keep-running-in-tray = false;
                                    root.close-action-changed(1);
                                }
                            }
                        }
                    }

                    GroupBox {
                        title: "Exit profile";
                        vertical-stretch: 0;

                        VerticalBox {
                            spacing: 8px;

                            CheckBox {
                                text: "Load selected profile on exit";
                                checked <=> root.apply-exit-profile;

                                toggled => {
                                    root.apply-exit-profile-changed(self.checked);
                                }
                            }

                            ComboBox {
                                model: root.profiles;
                                current-index <=> root.exit-profile-index;
                                enabled: root.apply-exit-profile
                                    && root.profiles.length > 0;
                                horizontal-stretch: 1;

                                selected => {
                                    root.exit-profile-selected(self.current-value);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component AppTray inherits SystemTrayIcon {
    title: "Dynamic Color Profiles";
    tooltip: "Dynamic Color Profiles";
    icon: @image-url("assets/tray-icon.svg");

    in property <[string]> profiles;

    callback show-window();
    callback load-profile(string);
    callback quit-requested();

    clicked => {
        show-window();
    }

    Menu {
        MenuItem {
            title: "Open";
            activated => { root.show-window(); }
        }

        MenuSeparator {}

        if root.profiles.length == 0 : MenuItem {
            title: "No saved profiles";
            enabled: false;
        }

        for profile in root.profiles : MenuItem {
            title: profile;
            activated => { root.load-profile(profile); }
        }

        MenuSeparator {}

        MenuItem {
            title: "Exit";
            activated => { root.quit-requested(); }
        }
    }
}
